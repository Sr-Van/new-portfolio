---
import Layout from '../layouts/Layout.astro';

const sections = [
  { href: '/projetos', label: 'projetos' },
  { href: '/habilidades', label: 'habilidades' },
  { href: '/formacao', label: 'formação' },
  { href: '/links', label: 'links' },
  { href: '/ferramentas', label: 'ferramentas' },
];
---

<Layout title="Vanderson Erlan — Desenvolvedor Web Full Stack">
  <div class="space-y-8">
    
    <!-- Status de Disponibilidade -->
    <div>
      <div class="inline-flex items-center gap-2 px-2.5 py-1 text-xs font-mono text-sky-400 bg-sky-950/40 border border-sky-900/60 rounded">
        <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
        <span>disponível para oportunidades • remoto / brasil</span>
      </div>
    </div>

    <!-- Identificação -->
    <header class="space-y-1">
      <div class="flex items-center gap-2 text-xs text-zinc-500 font-mono pb-0.5">
        <span>Fortaleza - Ceará</span>
        <span>•</span>
        <span>Brasil</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">
        Vanderson Erlan
      </h1>
      <p class="text-zinc-400 text-base sm:text-lg">
        Desenvolvedor Web Full Stack
      </p>
    </header>

    <!-- Resumo Direto -->
    <section class="space-y-4 text-zinc-300 text-base leading-relaxed">
      <p>
        Construindo interfaces, sistemas e <a href="/projetos">soluções</a> para a Web. Gosto de tornar minhas ideias alcançáveis. Gosto de lidar com pessoas diretamente, penso que todo avanço derivou das interações entre indivíduos.
      </p>
    </section>

    <!-- Ação Rápida de Contato -->
    <div class="flex items-center gap-3 pt-1">
      <button
        id="copy-email-btn"
        data-email="vanderson.dev1@gmail.com"
        type="button"
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded bg-zinc-950 hover:bg-zinc-900 text-zinc-300 hover:text-white border border-zinc-800 text-xs font-mono transition-colors cursor-pointer group"
        title="Copiar e-mail para a área de transferência"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-3.5 h-3.5 text-zinc-500 group-hover:text-sky-400 transition-colors"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
        </svg>
        <span id="copy-email-text">copiar e-mail</span>
      </button>

      <a
        href="https://linkedin.com/in/vanderson-erlan"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-zinc-400 hover:text-sky-400 font-mono"
      >
        linkedin &rarr;
      </a>
    </div>

    <!-- Navegação para as Seções -->
    <nav class="pt-6 border-t border-zinc-900">
      <h3 class="text-zinc-400 text-sm pb-2 sm:text-lg">Menu</h3>
      <ul class="space-y-3 text-base">
        {sections.map((section) => (
          <li class="flex items-center gap-2 group [perspective:500px]">
            <span
              class="inline-flex text-zinc-500 transition-all duration-300 group-hover:text-sky-400 group-hover:[transform:rotateX(360deg)] select-none"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-3.5 h-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
            <a href={section.href}>{section.label}</a>
          </li>
        ))}
      </ul>
    </nav>

  </div>
</Layout>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-email-text');

  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email') || 'vanderson.dev1@gmail.com';
      try {
        await navigator.clipboard.writeText(email);
        const originalText = copyText.textContent;
        copyText.textContent = 'copiado!';
        copyText.classList.add('text-sky-400');
        setTimeout(() => {
          copyText.textContent = originalText;
          copyText.classList.remove('text-sky-400');
        }, 2000);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  }
</script>
