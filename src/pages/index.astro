---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Vanderson Erlan — Desenvolvedor Web Full Stack">
  <div class="space-y-8">
    
    <!-- Identificação -->
    <header class="space-y-1">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">
        Vanderson Erlan
      </h1>
      <p class="text-zinc-400 text-base sm:text-lg">
        Desenvolvedor Web Full Stack
      </p>
    </header>

    <!-- Resumo Direto -->
    <section class="space-y-4 text-zinc-300 text-base leading-relaxed">
      <p>
        Estudante de Ciência da Computação e desenvolvedor focado em criar soluções que equilibram tecnologia robusta e aplicabilidade prática.
      </p>
      <p>
        Experiência com Angular, React, TypeScript, Node.js e Python. Vivência prática em ambientes com Docker, automação de fluxos CI/CD e integração com GenAI.
      </p>
    </section>

    <!-- Navegação para as Sessões -->
    <nav class="pt-6 border-t border-zinc-900">
      <ul class="space-y-3 text-base">
        <li>
          <a href="/projetos">projetos</a>
        </li>
        <li>
          <a href="/habilidades">habilidades</a>
        </li>
        <li>
          <a href="/formacao">formacao</a>
        </li>
        <li>
          <a href="/links">links</a>
        </li>
        <li>
          <a href="/ferramentas">ferramentas</a>
        </li>
      </ul>
    </nav>

  </div>
</Layout>
