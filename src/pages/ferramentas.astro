---
import Layout from '../layouts/Layout.astro';
import { toolsList } from '../data/tools';
---

<Layout title="Ferramentas — Vanderson Erlan">
  <div class="space-y-8">
    
    <!-- Link de Retorno -->
    <nav>
      <a href="/" class="text-sm text-zinc-400 hover:text-white no-underline hover:underline">
        &larr; voltar
      </a>
    </nav>

    <!-- Cabeçalho -->
    <header class="space-y-2">
      <h1 class="text-2xl font-bold tracking-tight text-white">
        ferramentas
      </h1>
      <p class="text-zinc-400 text-sm leading-relaxed">
        Sistemas, editores, terminais e ferramentas que utilizo no desenvolvimento diário.
      </p>
    </header>

    <!-- Lista de Ferramentas -->
    <section class="pt-4 border-t border-zinc-900 space-y-8">
      {toolsList.map((group) => (
        <div class="space-y-3">
          <h2 class="text-base font-semibold text-white">
            {group.category}
          </h2>
          <ul class="space-y-2 text-sm">
            {group.items.map((tool) => (
              <li class="space-y-0.5">
                <span class="text-white font-medium block">
                  {tool.name}
                </span>
                <span class="text-zinc-400 text-xs block">
                  {tool.description}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

  </div>
</Layout>
