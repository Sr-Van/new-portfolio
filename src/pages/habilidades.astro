---
import Layout from '../layouts/Layout.astro';
import { skillsData } from '../data/skills';
---

<Layout title="Habilidades — Vanderson Erlan">
  <div class="space-y-8">
    
    <!-- Link de Retorno -->
    <nav>
      <a href="/" class="text-sm text-zinc-400 hover:text-white no-underline hover:underline">
        &larr; voltar
      </a>
    </nav>

    <!-- Cabeçalho -->
    <header class="space-y-2">
      <h1 class="text-2xl font-bold tracking-tight text-white">
        habilidades
      </h1>
      <p class="text-zinc-400 text-sm leading-relaxed">
        Tecnologias, linguagens e ferramentas com as quais trabalho no desenvolvimento de software.
      </p>
    </header>

    <!-- Lista Direta de Habilidades -->
    <section class="pt-4 border-t border-zinc-900 space-y-8">
      {skillsData.map((category) => (
        <div class="space-y-3">
          <h2 class="text-base font-semibold text-white">
            {category.category.pt}
          </h2>
          <ul class="space-y-1 text-sm text-zinc-300">
            {category.skills.map((skill) => (
              <li class="flex items-center gap-2">
                <span class="text-zinc-600">—</span>
                <span>{skill.name}</span>
                {skill.highlight && (
                  <span class="text-[10px] font-mono text-zinc-500">[foco]</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

  </div>
</Layout>
