---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Formação — Vanderson Erlan">
  <div class="space-y-8">
    
    <!-- Link de Retorno -->
    <nav>
      <a href="/" class="text-sm text-zinc-400 hover:text-white no-underline hover:underline">
        &larr; voltar
      </a>
    </nav>

    <!-- Cabeçalho -->
    <header class="space-y-2">
      <h1 class="text-2xl font-bold tracking-tight text-white">
        formação
      </h1>
      <p class="text-zinc-400 text-sm leading-relaxed">
        Trajetória acadêmica na área de computação e idiomas.
      </p>
    </header>

    <!-- Cursos Superiores -->
    <section class="pt-4 border-t border-zinc-900 space-y-6">
      <div class="space-y-1">
        <h2 class="text-base font-semibold text-white">
          Bacharelado em Ciência da Computação
        </h2>
        <p class="text-sm text-zinc-400">
          Estácio de Sá • Polo Aracaju/SE
        </p>
        <p class="text-xs text-zinc-500 font-mono">
          Julho 2024 — Cursando
        </p>
      </div>

      <div class="space-y-1">
        <h2 class="text-base font-semibold text-white">
          Tecnólogo em Análise e Desenvolvimento de Sistemas
        </h2>
        <p class="text-sm text-zinc-400">
          Estácio de Sá • Polo Aracaju/SE
        </p>
        <p class="text-xs text-zinc-500 font-mono">
          Fevereiro 2018 — Dezembro 2021 (Concluído)
        </p>
      </div>
    </section>

    <!-- Idiomas -->
    <section class="pt-6 border-t border-zinc-900 space-y-3">
      <h2 class="text-base font-semibold text-white">
        idiomas
      </h2>
      <ul class="space-y-1 text-sm text-zinc-300">
        <li>
          <span class="text-white font-medium">Português:</span> Nativo
        </li>
        <li>
          <span class="text-white font-medium">Inglês:</span> Avançado (leitura, escrita técnica e conversação)
        </li>
      </ul>
    </section>

  </div>
</Layout>
