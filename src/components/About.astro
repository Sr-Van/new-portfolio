---
import type { Lang } from '../data/translations';
import { siteContent } from '../data/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = siteContent[lang];
---

<section id="formacao" class="py-24 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mb-16">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-bold text-emerald-400 tracking-widest uppercase mb-3 px-3 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20">
        <span>//</span>
        <span>TRAJECTORY &amp; SPECS</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-display font-extrabold text-white tracking-tight">
        {t.education.sectionTitle}
      </h2>
      <p class="mt-3 text-slate-400 max-w-2xl text-base sm:text-lg">
        {t.education.sectionSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Education Cards (8 cols) -->
      <div class="lg:col-span-8 space-y-6">
        <h3 class="text-xl font-display font-bold text-white flex items-center gap-2.5">
          <span class="text-emerald-400 font-mono">[01]</span>
          <span>{lang === 'pt' ? 'Formação Superior' : 'Higher Education'}</span>
        </h3>

        <div class="space-y-4">
          {t.education.degrees.map((deg, idx) => (
            <div class="tilt-card glow-card p-6 sm:p-7 rounded-2xl bg-[#090e1b] border border-slate-800/80 hover:border-slate-700 transition">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                <h4 class="text-lg font-display font-bold text-white">
                  {deg.course}
                </h4>
                <span class="text-xs font-mono font-bold text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20 w-fit">
                  {deg.period}
                </span>
              </div>
              <p class="text-sm font-medium text-slate-300">
                {deg.institution}
              </p>
              <div class="flex items-center gap-3 mt-4 pt-3 border-t border-slate-800/80 text-xs font-mono text-slate-400">
                <span>STATUS:</span>
                <span class="text-emerald-400 font-semibold">{deg.status}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Languages & Philosophy (4 cols) -->
      <div class="lg:col-span-4 space-y-6">
        <h3 class="text-xl font-display font-bold text-white flex items-center gap-2.5">
          <span class="text-cyan-400 font-mono">[02]</span>
          <span>{t.education.languages.title}</span>
        </h3>

        <!-- Language Pill Box -->
        <div class="p-6 rounded-2xl bg-[#090e1b] border border-slate-800/80 space-y-4">
          {t.education.languages.items.map((item) => (
            <div class="pb-3 border-b border-slate-800/80 last:border-none last:pb-0 space-y-1">
              <div class="flex items-center justify-between">
                <span class="text-sm font-display font-bold text-white">{item.name}</span>
                <span class="text-xs font-mono text-emerald-400 font-bold bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
                  {item.level.split(' ')[0]}
                </span>
              </div>
              <p class="text-xs font-mono text-slate-400">{item.level}</p>
            </div>
          ))}
        </div>

        <!-- Craft Mindset Box -->
        <div class="p-6 rounded-2xl bg-gradient-to-br from-emerald-500/15 via-[#090e1b] to-violet-500/10 border border-emerald-500/30">
          <h4 class="text-xs font-mono uppercase tracking-widest text-emerald-300 font-bold mb-2 flex items-center gap-2">
            <span>⚡</span>
            <span>{lang === 'pt' ? 'FILOSOFIA TÉCNICA' : 'TECHNICAL PHILOSOPHY'}</span>
          </h4>
          <p class="text-xs text-slate-300 leading-relaxed font-mono">
            {lang === 'pt' 
              ? 'Desenvolvimento centrado em resolver problemas práticos com simplicidade elegante, testes, automação e alto padrão de acabamento visual e de código.'
              : 'Focused on solving real problems through elegant simplicity, testability, automation and high craftsmanship in both UI and architecture.'}
          </p>
        </div>

      </div>

    </div>

  </div>
</section>
