---
import type { Lang } from '../data/translations';
import { siteContent } from '../data/translations';
import { projectsData } from '../data/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = siteContent[lang];

// Separa os projetos marcados como principais dos demais
const featuredProjects = projectsData.filter((p) => p.featured);
const otherProjects = projectsData.filter((p) => !p.featured);
---

<section id="projetos" class="py-20 border-t border-slate-900">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mb-14">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-emerald-400 tracking-wider uppercase mb-2">
        <span>//</span>
        <span>Portfolio</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        {t.projects.sectionTitle}
      </h2>
      <p class="mt-2 text-slate-400 max-w-2xl text-base">
        {t.projects.sectionSubtitle}
      </p>
    </div>

    <!-- 1. PROJETOS PRINCIPAIS (Destaques com estilo HTML/CSS especial) -->
    <div class="space-y-10 mb-16">
      {featuredProjects.map((project, idx) => (
        <article 
          class="project-card-featured relative rounded-2xl bg-gradient-to-br from-slate-900 via-slate-900/90 to-slate-950 border-2 border-emerald-500/30 hover:border-emerald-500/60 transition-all duration-300 p-6 sm:p-8 shadow-2xl shadow-emerald-950/20 overflow-hidden group"
        >
          <!-- Accent Corner Glow -->
          <div class="absolute -top-24 -right-24 w-48 h-48 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-emerald-500/20 transition-all"></div>

          <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6">
            <div class="space-y-4 max-w-3xl">
              
              <!-- Featured Tag Badge -->
              <div class="flex items-center gap-3">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 tracking-wide uppercase">
                  <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                  {project.badgeText ? project.badgeText[lang] : t.projects.featuredBadge}
                </span>
                <span class="text-xs font-mono text-slate-500 uppercase">#{idx + 1} Flagship</span>
              </div>

              <!-- Project Title -->
              <h3 class="text-2xl sm:text-3xl font-bold text-white group-hover:text-emerald-400 transition-colors">
                {project.title[lang]}
              </h3>

              <!-- Project Summary -->
              <p class="text-slate-300 text-base leading-relaxed">
                {project.summary[lang]}
              </p>

              <!-- Architecture / Implementation Highlights -->
              <div class="space-y-2 pt-2">
                <p class="text-xs font-mono uppercase text-slate-400 tracking-wider font-semibold">
                  {t.projects.keyHighlights}
                </p>
                <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm text-slate-300">
                  {project.description[lang].map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="text-emerald-400 mt-1 font-bold">✓</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Tech Badges -->
              <div class="flex flex-wrap gap-2 pt-3">
                {project.technologies.map((tech) => (
                  <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-emerald-950/40 border border-emerald-500/20 text-emerald-300">
                    {tech}
                  </span>
                ))}
              </div>

            </div>

            <!-- Action Buttons for Featured -->
            <div class="flex lg:flex-col items-center lg:items-stretch gap-3 shrink-0 pt-2 lg:pt-0">
              {project.githubUrl && (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-xs font-semibold text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 hover:border-emerald-500/40 transition w-full"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                  </svg>
                  <span>{t.projects.viewCode}</span>
                </a>
              )}
              {project.liveUrl && (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-lg text-xs font-semibold text-slate-950 bg-emerald-400 hover:bg-emerald-300 transition w-full"
                >
                  <span>{t.projects.liveDemo}</span>
                  <span>&nearr;</span>
                </a>
              )}
            </div>

          </div>
        </article>
      ))}
    </div>

    <!-- 2. DEMAIS PROJETOS / PROJETOS SECUNDÁRIOS (Grid mais compacto) -->
    {otherProjects.length > 0 && (
      <div>
        <h3 class="text-xl font-bold text-slate-200 mb-6 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-slate-500"></span>
          <span>{lang === 'pt' ? 'Outros Projetos & Estudos' : 'Other Projects & Studies'}</span>
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {otherProjects.map((project) => (
            <article class="project-card-secondary p-6 rounded-xl bg-slate-900/60 border border-slate-800/80 hover:border-slate-700 transition flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono text-slate-400">{project.category.toUpperCase()}</span>
                  <div class="flex items-center gap-2">
                    {project.githubUrl && (
                      <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white transition">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                      </a>
                    )}
                    {project.liveUrl && (
                      <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-emerald-400 transition text-sm">
                        &nearr;
                      </a>
                    )}
                  </div>
                </div>

                <h4 class="text-xl font-bold text-white hover:text-emerald-400 transition">
                  {project.title[lang]}
                </h4>

                <p class="text-sm text-slate-400 leading-relaxed">
                  {project.summary[lang]}
                </p>
              </div>

              <div class="flex flex-wrap gap-1.5 pt-4">
                {project.technologies.map((tech) => (
                  <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-800 text-slate-300">
                    {tech}
                  </span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    )}

  </div>
</section>
