---
import type { Lang } from '../data/translations';
import { siteContent } from '../data/translations';
import { projectsData } from '../data/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = siteContent[lang];

// Separa os projetos marcados como principais dos demais
const featuredProjects = projectsData.filter((p) => p.featured);
const otherProjects = projectsData.filter((p) => !p.featured);
---

<section id="projetos" class="py-24 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header with Craft Badge -->
    <div class="mb-16">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-bold text-emerald-400 tracking-widest uppercase mb-3 px-3 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20">
        <span>//</span>
        <span>LABORATORY &amp; WORK</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-display font-extrabold text-white tracking-tight">
        {t.projects.sectionTitle}
      </h2>
      <p class="mt-3 text-slate-400 max-w-2xl text-base sm:text-lg">
        {t.projects.sectionSubtitle}
      </p>
    </div>

    <!-- 1. FLAGSHIP PROJECTS (Jhey-Style Rotating Conic Gradient Border + 3D Tilt) -->
    <div class="space-y-12 mb-20">
      {featuredProjects.map((project, idx) => (
        <div class="conic-border-box">
          <article class="conic-border-inner tilt-card glow-card p-6 sm:p-10 flex flex-col justify-between">
            
            <div class="space-y-6">
              <!-- Top bar / Spec badge -->
              <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-800/80">
                <div class="flex items-center gap-2.5">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 uppercase tracking-wider shadow-[0_0_12px_rgba(16,185,129,0.3)]">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                    <span>★ {project.badgeText ? project.badgeText[lang] : t.projects.featuredBadge}</span>
                  </span>
                  <span class="text-xs font-mono text-slate-500">
                    [FLAGSHIP_0{idx + 1}]
                  </span>
                </div>

                <div class="text-xs font-mono text-slate-400 flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                  <span class="uppercase tracking-wider">{project.category}</span>
                </div>
              </div>

              <!-- Title & Summary -->
              <div class="space-y-3">
                <h3 class="text-2xl sm:text-4xl font-display font-bold text-white tracking-tight group-hover:text-emerald-300 transition-colors">
                  {project.title[lang]}
                </h3>
                <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-3xl font-normal">
                  {project.summary[lang]}
                </p>
              </div>

              <!-- Architecture Breakdown Bullets -->
              <div class="p-5 rounded-xl bg-slate-950/60 border border-slate-800/80 space-y-3">
                <div class="text-xs font-mono uppercase tracking-wider text-emerald-400 font-semibold flex items-center gap-2">
                  <span>&gt;</span>
                  <span>{t.projects.keyHighlights}</span>
                </div>
                <ul class="grid grid-cols-1 md:grid-cols-2 gap-2.5 text-xs sm:text-sm text-slate-300 font-mono">
                  {project.description[lang].map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="text-emerald-400 font-bold mt-0.5">↳</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Technologies List -->
              <div class="flex flex-wrap items-center gap-2 pt-1">
                <span class="text-xs font-mono text-slate-500 mr-1">// stack:</span>
                {project.technologies.map((tech) => (
                  <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-slate-900 border border-slate-800 text-slate-200">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-3 pt-8 mt-6 border-t border-slate-800/80">
              {project.githubUrl && (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-tactile-secondary inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-mono text-xs font-bold text-slate-100 bg-slate-900 border border-slate-700/80 hover:text-white"
                >
                  <svg class="w-4 h-4 text-slate-300" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                  </svg>
                  <span>{t.projects.viewCode}</span>
                </a>
              )}
              {project.liveUrl && (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-tactile inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-mono text-xs font-bold text-slate-950 bg-emerald-400"
                >
                  <span>{t.projects.liveDemo}</span>
                  <span>&nearr;</span>
                </a>
              )}
            </div>

          </article>
        </div>
      ))}
    </div>

    <!-- 2. SECONDARY PROJECTS / EXPERIMENTS (Tactile Grid) -->
    {otherProjects.length > 0 && (
      <div>
        <div class="flex items-center gap-3 mb-8">
          <span class="w-3 h-3 rounded-full bg-slate-700"></span>
          <h3 class="text-xl sm:text-2xl font-display font-bold text-white">
            {lang === 'pt' ? 'Outros Projetos & Experimentos' : 'Other Projects & Experiments'}
          </h3>
          <div class="h-px bg-slate-800 flex-1 ml-4"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {otherProjects.map((project) => (
            <article class="tilt-card glow-card p-6 sm:p-7 rounded-2xl bg-[#090e1b] border border-slate-800/80 hover:border-slate-700 transition flex flex-col justify-between group">
              <div class="space-y-3">
                <div class="flex items-center justify-between pb-3 border-b border-slate-800/80">
                  <span class="text-[11px] font-mono text-emerald-400 uppercase tracking-wider">
                    // {project.category}
                  </span>
                  <div class="flex items-center gap-3">
                    {project.githubUrl && (
                      <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white transition" title="GitHub">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                      </a>
                    )}
                    {project.liveUrl && (
                      <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-emerald-400 transition text-sm font-mono" title="Live">
                        &nearr;
                      </a>
                    )}
                  </div>
                </div>

                <h4 class="text-xl font-display font-bold text-white group-hover:text-emerald-300 transition">
                  {project.title[lang]}
                </h4>

                <p class="text-sm text-slate-400 leading-relaxed font-normal">
                  {project.summary[lang]}
                </p>
              </div>

              <div class="flex flex-wrap gap-1.5 pt-5 mt-4 border-t border-slate-800/60">
                {project.technologies.map((tech) => (
                  <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-900 border border-slate-800 text-slate-300">
                    {tech}
                  </span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    )}

  </div>
</section>
