---
import type { Lang } from '../data/translations';
import { siteContent } from '../data/translations';
import { skillsData } from '../data/skills';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = siteContent[lang];
---

<section id="habilidades" class="py-24 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mb-16">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-bold text-emerald-400 tracking-widest uppercase mb-3 px-3 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20">
        <span>//</span>
        <span>ARSENAL &amp; CAPABILITIES</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-display font-extrabold text-white tracking-tight">
        {t.skills.sectionTitle}
      </h2>
      <p class="mt-3 text-slate-400 max-w-2xl text-base sm:text-lg">
        {t.skills.sectionSubtitle}
      </p>
    </div>

    <!-- 3-Column Tech Matrix -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {skillsData.map((category) => (
        <div class="tilt-card glow-card p-6 sm:p-8 rounded-2xl bg-[#090e1b] border border-slate-800/80 hover:border-slate-700 transition-all flex flex-col justify-between">
          <div>
            <!-- Category Header -->
            <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-800">
              <div>
                <span class="text-[10px] font-mono uppercase text-emerald-400 tracking-wider block">
                  MODULE
                </span>
                <h3 class="text-xl font-display font-bold text-white">
                  {category.category[lang]}
                </h3>
              </div>
              <span class="text-xs font-mono font-bold text-slate-400 bg-slate-900 border border-slate-800 px-2.5 py-1 rounded-md">
                {category.skills.length} items
              </span>
            </div>

            <!-- Skills List with Interactive Chips -->
            <div class="flex flex-wrap gap-2">
              {category.skills.map((skill) => (
                <span
                  class={`px-3 py-1.5 rounded-lg text-xs font-mono transition-all duration-200 cursor-default select-none ${
                    skill.highlight
                      ? 'bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 hover:border-emerald-400 hover:bg-emerald-500/20 font-bold shadow-[0_0_10px_rgba(16,185,129,0.15)]'
                      : 'bg-slate-900/90 text-slate-300 border border-slate-800 hover:border-slate-600'
                  }`}
                >
                  {skill.name}
                </span>
              ))}
            </div>
          </div>

          <div class="mt-8 pt-4 border-t border-slate-800/60 flex items-center justify-between text-[11px] font-mono text-slate-500">
            <span>READY_TO_DEPLOY</span>
            <span class="text-emerald-400">100%</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
