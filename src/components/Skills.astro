---
import type { Lang } from '../data/translations';
import { siteContent } from '../data/translations';
import { skillsData } from '../data/skills';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = siteContent[lang];
---

<section id="habilidades" class="py-20 border-t border-slate-900 bg-slate-950/40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mb-14">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-emerald-400 tracking-wider uppercase mb-2">
        <span>//</span>
        <span>Capabilities</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        {t.skills.sectionTitle}
      </h2>
      <p class="mt-2 text-slate-400 max-w-2xl text-base">
        {t.skills.sectionSubtitle}
      </p>
    </div>

    <!-- Skills Grid by Categories -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {skillsData.map((category) => (
        <div class="p-6 rounded-2xl bg-slate-900/40 border border-slate-800/80 hover:border-slate-700/80 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-800">
              <h3 class="text-lg font-bold text-white">
                {category.category[lang]}
              </h3>
              <span class="text-xs font-mono text-emerald-400">
                {category.skills.length} skills
              </span>
            </div>

            <div class="flex flex-wrap gap-2">
              {category.skills.map((skill) => (
                <span
                  class={`px-3 py-1.5 rounded-lg text-xs font-mono transition ${
                    skill.highlight
                      ? 'bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 font-semibold'
                      : 'bg-slate-800/80 text-slate-300 border border-slate-700/60'
                  }`}
                >
                  {skill.name}
                </span>
              ))}
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-800/40 text-[11px] font-mono text-slate-500">
            {lang === 'pt' ? 'Foco em boas práticas e tipagem' : 'Focus on best practices & typing'}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
