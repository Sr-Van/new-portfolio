---
import type { Lang } from '../data/translations';
import { siteContent } from '../data/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = siteContent[lang];
const isPt = lang === 'pt';
const basePrefix = isPt ? '' : '/en';
---

<section class="relative pt-32 pb-20 md:pt-44 md:pb-28 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Main Pitch & Creative Typography (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Status Indicator Pill -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-emerald-950/60 border border-emerald-500/40 text-xs font-mono text-emerald-300 shadow-[0_0_15px_rgba(16,185,129,0.2)]">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="tracking-wide uppercase">{t.hero.badge}</span>
        </div>

        <!-- Hero Title -->
        <div class="space-y-2">
          <p class="font-mono text-xs sm:text-sm uppercase tracking-widest text-slate-400 flex items-center gap-2">
            <span class="text-emerald-400 font-bold">&gt;&gt;</span>
            <span>{t.hero.greeting}</span>
          </p>
          <h1 class="text-5xl sm:text-6xl md:text-7xl font-display font-extrabold tracking-tight text-white leading-[1.05]">
            Vanderson <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-cyan-400 to-violet-400">
              Erlan.
            </span>
          </h1>
          <p class="text-xl sm:text-2xl font-display font-semibold text-slate-300 pt-1">
            {t.hero.role}
          </p>
        </div>

        <!-- Description -->
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-xl font-normal">
          {t.hero.summary}
        </p>

        <!-- Tactile Mechanical CTAs -->
        <div class="flex flex-wrap items-center gap-4 pt-3">
          <a
            href={`${basePrefix}#projetos`}
            class="btn-tactile inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-mono text-xs sm:text-sm font-bold text-slate-950 bg-emerald-400 cursor-pointer"
          >
            <span>{t.hero.primaryCta}</span>
            <span class="text-slate-950 font-bold">&darr;</span>
          </a>

          <a
            href={`${basePrefix}#contato`}
            class="btn-tactile-secondary inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-mono text-xs sm:text-sm font-bold text-slate-200 bg-slate-900 border border-slate-700/80 cursor-pointer"
          >
            <span>{t.hero.secondaryCta}</span>
            <span class="text-emerald-400">&nearr;</span>
          </a>

          <a
            href="/curriculo-vanderson.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-mono text-slate-400 hover:text-emerald-300 transition"
          >
            <span>{t.hero.cvCta}</span>
            <span>&rarr;</span>
          </a>
        </div>

      </div>

      <!-- Interactive Spec Card / Dev HUD (5 cols) -->
      <div class="lg:col-span-5">
        <div class="tilt-card glow-card p-6 sm:p-7 rounded-2xl bg-gradient-to-br from-[#0c1324] via-[#090f1d] to-[#060a14] border border-slate-800 shadow-[0_20px_50px_rgba(0,0,0,0.6)] relative group">
          
          <!-- Terminal header dots -->
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-800/80 text-xs font-mono text-slate-400">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
            </div>
            <span class="text-[11px] text-slate-500">engineer_profile.ts</span>
          </div>

          <!-- Code / Spec Block -->
          <div class="font-mono text-xs space-y-2.5 text-slate-300 leading-relaxed">
            <p class="text-slate-500">// {lang === 'pt' ? 'Resumo de competências' : 'Capabilities spec'}</p>
            <p>
              <span class="text-violet-400">const</span> <span class="text-emerald-400">engineer</span> = &#123;
            </p>
            <div class="pl-4 space-y-1 text-[11px] sm:text-xs">
              <p><span class="text-slate-400">focus:</span> <span class="text-amber-300">"Full Stack Web"</span>,</p>
              <p><span class="text-slate-400">frontend:</span> [<span class="text-cyan-300">"Angular 17"</span>, <span class="text-cyan-300">"React"</span>, <span class="text-cyan-300">"Tailwind"</span>],</p>
              <p><span class="text-slate-400">backend:</span> [<span class="text-emerald-300">"Node.js"</span>, <span class="text-emerald-300">"Express"</span>, <span class="text-emerald-300">"Python"</span>, <span class="text-emerald-300">"Flask"</span>],</p>
              <p><span class="text-slate-400">devops_ai:</span> [<span class="text-violet-300">"Docker"</span>, <span class="text-violet-300">"CI/CD"</span>, <span class="text-violet-300">"GenAI"</span>],</p>
              <p><span class="text-slate-400">english:</span> <span class="text-emerald-400">"Advanced (C1)"</span>,</p>
              <p><span class="text-slate-400">status:</span> <span class="text-emerald-400">"Open for hire"</span></p>
            </div>
            <p>&#125;;</p>
          </div>

          <!-- Quick Stat Badges -->
          <div class="grid grid-cols-2 gap-3 pt-5 mt-5 border-t border-slate-800/80">
            <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800 text-center">
              <span class="block text-xl font-display font-bold text-white">35+</span>
              <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">GitHub Repos</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800 text-center">
              <span class="block text-xl font-display font-bold text-emerald-400">100/100</span>
              <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">Lighthouse Perf</span>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>
