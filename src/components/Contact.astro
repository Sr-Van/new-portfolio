---
import type { Lang } from '../data/translations';
import { siteContent } from '../data/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = siteContent[lang];
---

<section id="contato" class="py-20 border-t border-slate-900 bg-slate-950/60">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
    
    <!-- Section Header -->
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-emerald-400 tracking-wider uppercase">
        <span>//</span>
        <span>Contact</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        {t.contact.sectionTitle}
      </h2>
      <p class="text-slate-400 max-w-xl mx-auto text-base">
        {t.contact.sectionSubtitle}
      </p>
    </div>

    <!-- Email Box with Copy to Clipboard Button -->
    <div class="p-6 sm:p-8 rounded-2xl bg-slate-900/80 border border-slate-800 max-w-xl mx-auto space-y-4">
      <p class="text-xs font-mono text-slate-400 uppercase tracking-wider">
        {lang === 'pt' ? 'E-mail Principal' : 'Direct Email'}
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <code id="email-text" class="text-base sm:text-lg font-mono font-semibold text-white bg-slate-950 px-4 py-2.5 rounded-lg border border-slate-800 select-all">
          {t.contact.directEmail}
        </code>
        
        <button
          id="copy-email-btn"
          type="button"
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-xs font-semibold text-slate-950 bg-emerald-400 hover:bg-emerald-300 transition shadow-md shadow-emerald-500/10 cursor-pointer w-full sm:w-auto"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span id="copy-btn-text">{t.contact.copyEmail}</span>
        </button>
      </div>
    </div>

    <!-- Social & Links Grid -->
    <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
      <a
        href="https://linkedin.com/in/vanderson-erlan"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-200 bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 transition"
      >
        <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
        </svg>
        <span>{t.contact.linkedin}</span>
      </a>

      <a
        href="https://github.com/Sr-Van"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-200 bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 transition"
      >
        <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>{t.contact.github}</span>
      </a>

      <a
        href="/curriculo-vanderson.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-950 bg-slate-100 hover:bg-white transition shadow-sm"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>{lang === 'pt' ? 'Baixar Currículo (PDF)' : 'Download Resume (PDF)'}</span>
      </a>
    </div>

  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyBtnText = document.getElementById('copy-btn-text');
  const emailText = document.getElementById('email-text');

  if (copyBtn && copyBtnText && emailText) {
    copyBtn.addEventListener('click', async () => {
      const email = emailText.textContent?.trim() || '';
      try {
        await navigator.clipboard.writeText(email);
        const originalText = copyBtnText.textContent;
        copyBtnText.textContent = '✓ Copiado!';
        setTimeout(() => {
          copyBtnText.textContent = originalText;
        }, 2000);
      } catch (err) {
        console.error('Falha ao copiar:', err);
      }
    });
  }
</script>
