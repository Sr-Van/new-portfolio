---
import type { Lang } from '../data/translations';
import { siteContent } from '../data/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = siteContent[lang];
const isPt = lang === 'pt';
const basePrefix = isPt ? '' : '/en';
---

<header class="fixed top-4 inset-x-0 z-50 flex justify-center px-4 pointer-events-none">
  <div class="pointer-events-auto flex items-center justify-between gap-4 sm:gap-8 px-5 py-2.5 rounded-full bg-[#0a0f1d]/85 backdrop-blur-xl border border-slate-700/60 shadow-[0_8px_30px_rgb(0,0,0,0.5)] transition-all max-w-4xl w-full">
    
    <!-- Brand / Monogram with pulse dot -->
    <a href={isPt ? '/' : '/en'} class="flex items-center gap-2.5 group">
      <div class="relative flex items-center justify-center w-8 h-8 rounded-full bg-slate-900 border border-emerald-500/40 text-emerald-400 font-mono text-xs font-bold shadow-[0_0_12px_rgba(16,185,129,0.3)] group-hover:scale-105 group-hover:border-emerald-400 transition-all">
        <span class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-emerald-400"></span>
        V
      </div>
      <span class="font-display font-bold text-sm tracking-tight text-white group-hover:text-emerald-400 transition">
        Van<span class="text-emerald-400 font-mono">.dev</span>
      </span>
    </a>

    <!-- Navigation Hub (Desktop) -->
    <nav class="hidden md:flex items-center gap-1 text-xs font-mono font-medium text-slate-300">
      <a href={`${basePrefix}#projetos`} class="px-3 py-1.5 rounded-full hover:bg-slate-800/80 hover:text-emerald-300 transition">
        // {t.nav.projects}
      </a>
      <a href={`${basePrefix}#habilidades`} class="px-3 py-1.5 rounded-full hover:bg-slate-800/80 hover:text-emerald-300 transition">
        // {t.nav.skills}
      </a>
      <a href={`${basePrefix}#formacao`} class="px-3 py-1.5 rounded-full hover:bg-slate-800/80 hover:text-emerald-300 transition">
        // {t.nav.education}
      </a>
      <a href={`${basePrefix}#contato`} class="px-3 py-1.5 rounded-full hover:bg-slate-800/80 hover:text-emerald-300 transition">
        // {t.nav.contact}
      </a>
    </nav>

    <!-- Language Selector & Tactile Resume Pill -->
    <div class="flex items-center gap-2.5">
      <!-- Language Pill Switcher -->
      <div class="flex items-center p-0.5 rounded-full bg-slate-900/90 border border-slate-800 text-[11px] font-mono font-bold">
        <a
          href="/"
          class={`px-2.5 py-1 rounded-full transition-all ${
            isPt 
              ? 'bg-emerald-500 text-slate-950 shadow-[0_0_10px_rgba(16,185,129,0.5)]' 
              : 'text-slate-400 hover:text-slate-200'
          }`}
          title="Versão em Português"
        >
          PT
        </a>
        <a
          href="/en"
          class={`px-2.5 py-1 rounded-full transition-all ${
            !isPt 
              ? 'bg-emerald-500 text-slate-950 shadow-[0_0_10px_rgba(16,185,129,0.5)]' 
              : 'text-slate-400 hover:text-slate-200'
          }`}
          title="English Version"
        >
          EN
        </a>
      </div>

      <!-- Resume Button -->
      <a
        href="/curriculo-vanderson.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center justify-center px-3.5 py-1.5 text-xs font-mono font-semibold text-slate-200 hover:text-white bg-slate-900 hover:bg-slate-800 border border-slate-700 hover:border-emerald-400 rounded-full transition shadow-sm"
      >
        <span>CV.pdf</span>
        <span class="ml-1 text-emerald-400">&darr;</span>
      </a>
    </div>

  </div>
</header>
